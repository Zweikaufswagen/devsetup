{
  "name": "Lucas · DevPod Basis",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "containerUser": "devpod",
  "remoteUser": "devpod",
  "updateRemoteUserUID": true,
  "init": true,
  "overrideCommand": true,
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/project,type=bind",
  "mounts": [
    "source=${localEnv:USERPROFILE}/.company-certs,target=/usr/local/share/ca-certificates/company,type=bind,readonly"
  ],
  "workspaceFolder": "/workspaces/project",
  "postCreateCommand": "uv tool install pre-commit && git config --global --add safe.directory /workspaces/project && pre-commit install && sudo update-ca-certificates"
}